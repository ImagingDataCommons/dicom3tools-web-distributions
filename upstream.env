# The dicom3tools source the wasm is built from.
#
# build.sh checks out exactly this commit, so the same pin always compiles the
# same source. .github/workflows/watch-upstream.yml opens a pull request that
# moves it when upstream changes; nothing else should need to edit this file.
#
# UPSTREAM_ARCHIVE is upstream's VERSION.txt at that commit, recorded so a
# reviewer can see which snapshot a pin bump moves to; build.sh fails if the
# checkout disagrees with it.
UPSTREAM_REPO=ImagingDataCommons/dicom3tools
UPSTREAM_COMMIT=8b842316c0955d87ec28087198ab6107cc2306b5
UPSTREAM_ARCHIVE=dicom3tools_1.00.snapshot.20260901072548.tar.bz2
